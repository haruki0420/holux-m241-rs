/target/
**/*.rs.bk
*.pdb
.DS_Store

# Vendor drops and device data are never committed. See docs/dev/02-provenance.md.
/holux/
/vendor/
/backup/
/backups/
/*.bin
/*.dll
/*.exe
/*.zip
/DA_v3.8.*

# Device captures can contain the user's real coordinates.
/captures/
*.nmea
*.dump

# Local analysis scratch
/_scratch/
/.inbox/
# No trailing slash: the parallel worktrees get a *symlink* to the shared cargo
# cache, and a `dir/` pattern does not match a symlink, so it showed up as
# untracked in every worktree and was one `git add -A` from being committed.
/.cargo-home
/.rustup-home
/.worktrees/

# Rendered screen captures are build output; regenerate with `m241-gui --screenshot`.
/.design/
